{
  "name": "dsh-plugin-llm-balance",
  "version": "0.4.0",
  "description": "DSH（DeepSeek Harness）插件：自动跟随最近 provider 的可拖动 API 余额与 Coding Plan 配额卡片，凭据仅在服务端使用",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FengHuoLinShan/dsh-plugin-llm-balance.git"
  },
  "homepage": "https://github.com/FengHuoLinShan/dsh-plugin-llm-balance",
  "bugs": {
    "url": "https://github.com/FengHuoLinShan/dsh-plugin-llm-balance/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "moonshot",
    "kimi",
    "openai-codex",
    "codex",
    "chatgpt",
    "oauth",
    "opencode",
    "opencode-go",
    "openrouter",
    "minimax",
    "zai",
    "bigmodel",
    "api-balance",
    "quota",
    "billing"
  ],
  "license": "MIT",
  "peerDependencies": {
    "dsh-codex-connect": ">=0.1.0-alpha.4.5"
  },
  "peerDependenciesMeta": {
    "dsh-codex-connect": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
